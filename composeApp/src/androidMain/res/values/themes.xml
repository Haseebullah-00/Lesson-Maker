<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.LessonMaker"  parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:statusBarColor">@color/transparent</item>
      <!-- <item name="android:navigationBarColor">@color/transparent</item>-->
        <item name="android:navigationBarColor">@color/whiteColor</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialogTheme</item>
    </style>
    <style name="ThemForSplash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/colorPrimary</item>
        <item name="postSplashScreenTheme">@style/Theme.LessonMaker</item>
        <item name="windowSplashScreenAnimatedIcon">@color/transparent</item>
    </style>
    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="CustomBottomSheetStyle">
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize|stateVisible</item>
        <item name="behavior_peekHeight">auto</item>
        <item name="behavior_hideable">true</item>
        <item name="behavior_skipCollapsed">true</item>


        <!--        <item name="behavior_peekHeight">@dimen/_300sdp</item>-->
    </style>



    <style name="InputFormBackCard">
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardBackgroundColor">@color/whiteColor</item>
        <item name="strokeColor">@color/whiteColor</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="InputFormBackCardWithStroke" parent="InputFormBackCard">
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="CustomAutocompleteFragment" parent="Widget.AppCompat.AutoCompleteTextView">
        <!-- Customize the search icon to be transparent (invisible) -->
        <item name="android:background">@null</item> <!-- Remove background -->
        <item name="android:padding">0dp</item> <!-- Remove padding -->
        <item name="android:layout_margin">0dp</item> <!-- Remove margins -->
        <item name="android:drawableStart">@android:color/transparent</item> <!-- Hide the search icon -->
        <item name="android:drawablePadding">0dp</item><!-- Remove drawable padding -->
        <item name="android:inputType">text</item> <!-- Set input type to text -->
        <item name="android:imeOptions">actionDone</item>
        <item name="android:hint">Search</item>
    </style>

    <style name="popup_button">
        <item name="android:includeFontPadding">false</item>
        <item name="cornerRadius">@dimen/_20sdp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/whiteColor</item>
        <item name="android:textSize">@dimen/_13sdp</item>
        <item name="android:gravity">center</item>
    </style>

</resources>